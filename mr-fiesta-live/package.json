  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:capture": "node tests/clientCapture.cjs",
    "test:production": "node --import tsx --test tests/production*.test.ts",
